# Copy to .env and fill in real values: cp .env.example .env
# Use only letters and digits in passwords (they are embedded in connection URIs).

# PostgreSQL (MLflow backend store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# MinIO (S3-compatible artifact store for MLflow and DVC)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
