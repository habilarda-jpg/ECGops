# Normalise line endings: LF in the repository and in the working tree on every OS,
# so Windows and Linux (CI, Docker) see identical files and diffs.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.pt binary
*.pth binary
*.npz binary
*.prof binary
